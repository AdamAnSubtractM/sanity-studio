{
  "name": "portfolio-sanity-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "typecheck": "tsc --noEmit",
    "typegen:extract": "sanity schema extract --path=./schema.json",
    "typegen": "pnpm run typegen:extract && sanity typegen generate",
    "publish:types": "pnpm dlx jsr publish --token $JSR_API_TOKEN",
    "publish:types:dry": "pnpm dlx jsr publish --dry-run --allow-dirty",
    "dataset:export": "sanity dataset export development ./dataset-backups --overwrite",
    "dataset:export:production": "sanity dataset export production ./dataset-backups",
    "dataset:import:production": "sanity dataset import ./dataset-backups/development.tar.gz production --replace",
    "deploy": "sanity deploy",
    "deploy:graphql": "sanity graphql deploy",
    "deploy:graphql:production": "dotenv -e .env.production -- sanity graphql deploy",
    "deploy:production": "pnpm run dataset:export && pnpm run dataset:import:production && dotenv -e .env.production -- sanity deploy",
    "deploy:all": "pnpm run deploy && pnpm run deploy:production",
    "lint": "eslint .",
    "format": "prettier --write . && pnpm run lint"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^5.23.0",
    "groq": "^5.23.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.23.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
