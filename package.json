{
  "name": "portfolio-sanity-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "typecheck": "tsc --noEmit",
    "typegen:extract": "sanity schema extract --path=./schema.json --force",
    "typegen": "pnpm run typegen:extract && sanity typegen generate",
    "publish:types": "pnpm dlx jsr publish",
    "publish:types:dry": "pnpm dlx jsr publish --dry-run --allow-dirty",
    "dataset:export": "sanity dataset export production ./dataset-backups",
    "deploy": "sanity deploy",
    "deploy:graphql": "sanity graphql deploy",
    "lint": "eslint .",
    "format": "prettier --write . && pnpm run lint"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.10.1",
    "groq": "^6.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.10.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
